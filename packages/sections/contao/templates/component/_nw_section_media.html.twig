{# Picture of a section inside a figure box. Variables: image (UUID), size, class, eager. #}
{% use '@Contao/component/_picture.html.twig' %}
{% set picture = image ? figure(image, size, {options: {img_attr: eager|default(false) ? {loading: 'eager', fetchpriority: 'high'} : {loading: 'lazy'}}}) : null %}
{% if picture %}
    <figure class="{{ class }}">{% with {figure: picture} %}{{ block('picture_component') }}{% endwith %}</figure>
{% endif %}
