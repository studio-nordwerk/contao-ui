{% set carousel_options = carousel_options|merge({labels: {
    prev: 'nw.carousel.prev'|trans,
    next: 'nw.carousel.next'|trans,
    page: 'nw.carousel.page'|trans,
    status: 'nw.carousel.status'|trans,
    statusSingle: 'nw.carousel.status_single'|trans,
    play: 'nw.carousel.play'|trans,
    pause: 'nw.carousel.pause'|trans,
}}) %}
<div id="{{ carousel_id }}" class="sc" data-nw-carousel="{{ carousel_options|json_encode }}">
    <style nonce="{{ csp_nonce('style-src') }}">
        #{{ carousel_id }} > .sc-track { --sc-per-view: {{ carousel_options.small|default(1) }}; }
        @container sc (min-width: 600px) { #{{ carousel_id }} > .sc-track { --sc-per-view: {{ carousel_options.medium|default(1) }}; } }
        @container sc (min-width: 960px) { #{{ carousel_id }} > .sc-track { --sc-per-view: {{ carousel_options.large|default(1) }}; } }
    </style>
    <div class="sc-track" data-sc-track tabindex="0" aria-label="{{ carousel_label }}">
        {% block carousel_slides %}{% endblock %}
    </div>
    {% if carousel_options.arrows ?? true %}
        <button type="button" class="sc-nav sc-prev" data-sc-prev aria-label="{{ carousel_options.labels.prev }}">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button type="button" class="sc-nav sc-next" data-sc-next aria-label="{{ carousel_options.labels.next }}">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6" /></svg>
        </button>
    {% endif %}
    {% if carousel_options.autoplay|default(0) %}
        <button type="button" class="sc-play" data-sc-play aria-label="{{ carousel_options.labels.pause }}">
            <svg class="sc-icon-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" /></svg>
            <svg class="sc-icon-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
        </button>
    {% endif %}
    {% if carousel_options.dots ?? true %}<div class="sc-dots" data-sc-dots></div>{% endif %}
    <p class="sc-status" data-sc-status aria-live="polite"></p>
</div>
{% if not as_editor_view|default(false) %}
    {% add 'nw_carousel_css' to stylesheets %}
        <link rel="stylesheet" href="{{ asset('bundles/nordwerkcarousel/vendor/carousel.css') }}">
    {% endadd %}
    {% add 'nw_carousel_js' to body %}
        <script type="module" src="{{ asset('bundles/nordwerkcarousel/carousel.js') }}"></script>
    {% endadd %}
{% endif %}
