{% extends '@Contao/content_element/_base.html.twig' %}

{% block content %}
    {% if as_editor_view %}
        {{ include('@Contao/component/_nw_carousel_icon.html.twig') }} <strong>{{ data.nwCarouselLabel }}</strong>
        {% for fragment in nested_fragments %}{{ content_element(fragment) }}{% endfor %}
    {% else %}
    {% embed '@Contao/component/_nw_carousel.html.twig' with {
        carousel_id: 'nw-carousel-' ~ data.id,
        carousel_label: data.nwCarouselLabel|default(headline.text|default('Carousel')),
        carousel_options: carousel,
    } %}
        {% block carousel_slides %}
            {% for fragment in nested_fragments %}
                <div class="nw-carousel-slide">{{ content_element(fragment) }}</div>
            {% endfor %}
        {% endblock %}
    {% endembed %}
    {% endif %}
{% endblock %}
