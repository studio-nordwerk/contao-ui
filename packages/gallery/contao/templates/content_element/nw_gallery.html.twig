{% extends '@Contao/content_element/_base.html.twig' %}

{% block content %}
    {% if as_editor_view %}
        {{ include('@Contao/component/_nw_gallery_icon.html.twig') }} <strong>{{ data.nwGalleryLabel }}</strong>
        <p>{{ 'nw.gallery.count'|trans({'%count%': images|length}) }}</p>
    {% else %}
    {{ include('@Contao/component/_nw_gallery.html.twig', {gallery_id: 'nw-gallery-' ~ data.id, gallery_label: data.nwGalleryLabel, gallery_images: images, gallery_lightbox: data.fullsize and not as_editor_view}) }}
    {% endif %}
{% endblock %}
