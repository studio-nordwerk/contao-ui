<dialog class="ss {{ sheet_class|default('') }}" id="{{ sheet_id }}" data-ss="{{ sheet_options.presentation }}" data-nw-sheet="{{ sheet_options|json_encode }}" data-ss-dismissible="{{ sheet_options.dismissible ? 'true' : 'false' }}" closedby="{{ sheet_options.dismissible ? 'closerequest' : 'none' }}" aria-labelledby="{{ sheet_id }}-title">
    <div class="ss-panel">
        {% if sheet_options.presentation == 'bottom' %}
            {% for snap in sheet_options.snaps %}
                <i class="ss-snap" style="--ss-at: {{ snap }}dvh"{% if loop.first %} data-ss-initial{% endif %}></i>
            {% endfor %}
            <span class="ss-handle" aria-hidden="true"></span>
        {% endif %}
        <header class="ss-header">
            <h2 id="{{ sheet_id }}-title">{{ sheet_label }}</h2>
            {% if sheet_options.dismissible %}
                <button class="ss-close" type="button" commandfor="{{ sheet_id }}" command="close" aria-label="{{ 'nw.sheet.close'|trans }}">×</button>
            {% endif %}
        </header>
        <div class="ss-body">{% block sheet_body %}{% endblock %}</div>
    </div>
    <div class="ss-rest"></div>
</dialog>
{% do nw_sheet_assets(sheet_options.dismissible) %}
